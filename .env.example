# Server configuration (placeholders only — never commit real values)
TIMEREPORT_CONFIG=config/tenants.example.toml
TIMEREPORT_DATA_DIR=data
DATABASE_URL=sqlite:///data/timereport.db

# stdio single-tenant binding (required when transport=stdio)
TIMEREPORT_STDIO_TENANT=

# HTTP transport
TIMEREPORT_HTTP_HOST=127.0.0.1
TIMEREPORT_HTTP_PORT=8000
TIMEREPORT_RESOURCE_SERVER_URL=http://127.0.0.1:8000/mcp
TIMEREPORT_AUTH_ISSUER_URL=https://auth.example.invalid

# SMS — Phase 1 acceptance uses mock only
SMS_PROVIDER=mock
SMS_LIVE_SEND=false
# ELKS_API_USERNAME=
# ELKS_API_PASSWORD=
# ELKS_FROM=

# Rejected if present: do not set LLM_* keys for this server
